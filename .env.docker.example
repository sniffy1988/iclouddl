# Copy to .env: cp .env.docker.example .env
# Default: SQLite file DB in ./data/ (persisted on your machine via Docker bind mount)

DATABASE_URL=sqlite:////data/iclouddownloader.db

WEB_PORT=8765

# ANSI-colored log lines in api/worker console (docker compose logs -f)
FORCE_COLOR=1

# DB browser on http://127.0.0.1:8766 (sqlite-web read-only, or Adminer with postgres overlay)
DB_VIEWER_PORT=8766
DB_VIEWER_ENABLED=1
# DB_VIEWER_PASSWORD=optional-password-for-sqlite-web

BASE_DOWNLOAD_DIR=/data/downloads
COOKIE_DIR=/data/cookies

REDIS_URL=redis://redis:6379/0
REDIS_EVENTS_CHANNEL=icd:events
RQ_SYNC_QUEUE=sync
RQ_COUNT_QUEUE=count

DEFAULT_SYNC_INTERVAL_SECONDS=21600
MAX_CONCURRENT_DOWNLOADS=3
SCHEDULER_POLL_SECONDS=60

WEB_SESSION_SECRET=change-this-secret-key
WEB_PUBLIC_BASE_URL=http://localhost:8765
TOKEN_ENCRYPTION_KEY=

# Telegram + Google OAuth client: web UI → Settings (stored in the database).

# Optional: PostgreSQL instead of SQLite
# Use: docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d --build
# DATABASE_URL=postgresql+psycopg://iclouddownloader:iclouddownloader@postgres:5432/iclouddownloader
