# SQLite file database (default) — data stored under ./data/
DATABASE_URL=sqlite:///./data/iclouddownloader.db

BASE_DOWNLOAD_DIR=./data/downloads
COOKIE_DIR=./data/cookies

DEFAULT_SYNC_INTERVAL_SECONDS=21600
MAX_CONCURRENT_DOWNLOADS=3
SCHEDULER_POLL_SECONDS=60
# Relative path under each user folder: YYYY MM DD HH mm ss {filename}
DOWNLOAD_PATH_TEMPLATE=YYYY/MM/DD/{filename}

WEB_HOST=0.0.0.0
WEB_PORT=8765
# First admin: open the web UI and use “Create admin account” (stored in the database).
WEB_SESSION_SECRET=change-this-secret-key

# Telegram (bot token, chat ID, etc.): configure in the web UI under Settings — stored in the database.

# Apple 2FA on login: trusted_device (popup only), sms, or both
ICLOUD_2FA_DELIVERY=trusted_device
ICLOUD_TRUSTED_SESSION_DAYS=30

# Global minimum seconds between Immich library scans (per-user Immich config is in the DB / UI)
IMMICH_SCAN_DEBOUNCE_SECONDS=120

# Optional PostgreSQL:
# DATABASE_URL=postgresql+psycopg://iclouddownloader:iclouddownloader@localhost:5432/iclouddownloader
